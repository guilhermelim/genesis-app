DATABASE_URL=mongodb://localhost:27017/genesis?authSource=admin

# Base URL used by Better Auth for callbacks and trusted origins
BASE_URL=http://localhost:3000

# Secret key for encryption and hashing
# Minimum 32 characters with high entropy
#
# TO GENERATE A NEW SECRET:
#   openssl rand -base64 32
#
# NOTE: The CLI command "npx @better-auth/cli@latest secret" is deprecated
# and should not be used.
#
# If you need to rotate the secret without invalidating current sessions,
# use BETTER_AUTH_SECRETS (plural) with multiple keys:
#   BETTER_AUTH_SECRETS=2:new-key,1:old-key
BETTER_AUTH_SECRET="code-generated-secret"
