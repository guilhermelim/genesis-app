{
  // format
  "files.autoSave": "onFocusChange",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "editor.formatOnSave": true,

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // explorer
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "README.md": "LICENSE",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "tsconfig.json": "tsconfig.tsbuildinfo",
    "jest.config.ts": "jest.unit.setup.ts, jest.integration.setup.ts, jest.frontend.setup.ts",
    "next.config.ts": "next-env.d.ts",
    ".gitignore": ".prettierignore",
    "AGENTS.md": "skills-lock.json, opencode.json",
    ".env.local": ".env, .env.example, .env.test, .env.production",
    "*.ts": "$(capture).test.ts, $(capture).unit.test.ts, $(capture).integration.test.ts",
    "*.tsx": "$(capture).frontend.test.tsx",
    "*.js": "$(capture).test.js, $(capture).unit.test.js, $(capture).integration.test.js",
    "*.component.ts": "$(capture).component.html, $(capture).component.scss, $(capture).module.ts"
  },

  // ============================================================================
  // ÍCONES DE PASTAS E ARQUIVOS
  // ============================================================================
  "symbols.hidesExplorerArrows": false, // Exibe as setas de expansão no explorador de arquivos, mesmo com o tema de ícones "symbols", para facilitar a navegação em pastas
  "symbols.folders.associations": {
    // Define associações de ícones para pastas específicas, usando o tema "symbols"
    "@shared": "folder-shared",
  },
  "symbols.files.associations": {
    // Define associações de ícones para arquivos específicos, usando o tema "symbols"
    "jest.config.ts": "jest",
    "jest.unit.setup.ts": "jest",
    "jest.integration.setup.ts": "jest",
    "jest.frontend.setup.ts": "jest",
    "*.spec.ts": "ts-test",
    "*.e2e-spec.ts": "ts-test",
    "*.module.ts": "nest",
    "*.guard.ts": "typescript",
    ".env.example": "gear",
  },
}
