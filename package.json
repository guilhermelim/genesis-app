{
  "name": "genesis-app",
  "version": "1.0.0",
  "description": "Plataforma web de gestão de enquetes, membros e atividades construída com Next.js, TypeScript e MongoDB.",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "path-name-check": "tsx ./scripts/path-name-check/index.ts",
    "path-name-check:fix": "tsx ./scripts/path-name-check/index.ts --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "eslint:check": "eslint .",
    "eslint:fix": "eslint . --fix",
    "lint": "npm run path-name-check && npm run format:check && npm run eslint:check",
    "fix": "npm run path-name-check:fix && npm run format:fix && npm run eslint:fix",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:unit:watch": "jest --selectProjects unit --watch",
    "test:frontend": "jest --selectProjects frontend",
    "test:frontend:watch": "jest --selectProjects frontend --watch",
    "test:frontend:file": "jest --selectProjects frontend --runTestsByPath",
    "test:typecheck": "tsc --noEmit --pretty",
    "test:file": "jest --selectProjects unit --runTestsByPath",
    "test:integration": "jest --selectProjects integration",
    "test:integration:down": "docker compose -f docker/docker-compose.yml down",
    "test:coverage": "jest --coverage",
    "test:staged": "tsx scripts/hooks/run-staged-tests.ts",
    "test:quality": "npm run test:typecheck && npm run test:coverage",
    "test:ci": "npm run test:quality",
    "test:hooks": "sh scripts/hooks/test-pre-commit.sh",
    "clean": "rm -rf .next out build coverage",
    "admin": "tsx scripts/admin/manage.ts",
    "admin:create": "tsx scripts/admin/manage.ts --create",
    "admin:reset": "tsx scripts/admin/manage.ts --reset",
    "terminal:quality": "tsx scripts/terminal/quality-gate-visual.ts",
    "prepare": "husky",
    "update": "npx npm-check-updates -u && npm install"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clack/prompts": "^1.8.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.1",
    "@tailwindcss/postcss": "^4.3.4",
    "better-auth": "^1.7.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.68.0",
    "mongodb": "^7.8.0",
    "mongoose": "^8.17.2",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.1.0",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cli-progress": "^3.11.6",
    "@types/figlet": "^1.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "boxen": "^9.0.0",
    "chafa-wasm": "^0.3.3",
    "cli-progress": "^3.12.0",
    "cli-spinners": "^3.4.0",
    "eslint": "^9",
    "eslint-config-flat-gitignore": "^1.0.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^9.1.0",
    "figlet": "^1.12.0",
    "gradient-string": "^3.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "ora": "^8.1.1",
    "prettier": "3.4.2",
    "table": "^6.9.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
